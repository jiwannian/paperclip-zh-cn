--- /dev/null
+++ b/ui/src/components/LocaleSelector.tsx
@@ -0,0 +1,26 @@
+import { Languages } from "lucide-react";
+import { changeAppLocale, useTranslation } from "@/i18n";
+
+export function LocaleSelector() {
+  const { i18n, t } = useTranslation();
+  const activeLanguage = i18n.resolvedLanguage ?? i18n.language;
+  const value = activeLanguage.toLowerCase().startsWith("zh") ? "zh-CN" : "en";
+
+  return (
+    <label className="flex min-h-8 items-center gap-2.5 rounded-lg px-2.5 text-(length:--text-compact) font-medium text-foreground">
+      <span className="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
+        <Languages className="size-4" aria-hidden="true" />
+      </span>
+      <span className="min-w-0 flex-1">{t("ui.account.language")}</span>
+      <select
+        aria-label={t("ui.account.language")}
+        className="min-w-24 rounded-md border border-border bg-background py-1 pl-2 pr-6 text-xs text-foreground"
+        value={value}
+        onChange={(event) => void changeAppLocale(event.currentTarget.value)}
+      >
+        <option value="en">{t("ui.account.english")}</option>
+        <option value="zh-CN">{t("ui.account.simplifiedChinese")}</option>
+      </select>
+    </label>
+  );
+}
