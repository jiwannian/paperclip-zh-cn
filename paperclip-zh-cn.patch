+export type ResolvedCurrentUserPreferences = CurrentUserPreferences & { localOnly?: true };
+
+const localPreferencesKey = (userId: string) => `paperclip.user-preferences.${encodeURIComponent(userId)}`;
+
+function readLocalPreferences(userId: string): ResolvedCurrentUserPreferences {
+  try {
+    const stored = globalThis.localStorage.getItem(localPreferencesKey(userId));
+    const parsed: unknown = stored ? JSON.parse(stored) : null;
+    if (parsed && typeof parsed === "object" && typeof (parsed as Record<string, unknown>).keyboardShortcuts === "boolean") {
+      return { keyboardShortcuts: (parsed as { keyboardShortcuts: boolean }).keyboardShortcuts, localOnly: true };
+    }
+  } catch {
+    // Use the documented default when storage is disabled or malformed.
+  }
+  return { keyboardShortcuts: false, localOnly: true };
+}
+
+function writeLocalPreferences(userId: string, preferences: CurrentUserPreferences): ResolvedCurrentUserPreferences {
+  globalThis.localStorage.setItem(localPreferencesKey(userId), JSON.stringify(preferences));
+  return { ...preferences, localOnly: true };
+}
+
+function isMissingPreferencesRoute(error: unknown): error is AuthApiError {
+  return error instanceof AuthApiError && error.status === 404 && error.message === "API route not found";
+}
+
 export class AuthApiError extends Error {
   status: number;
   code: string | null;
