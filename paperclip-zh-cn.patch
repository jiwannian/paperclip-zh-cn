@@ -0,0 +1,80 @@
+import { describe, expect, it } from "vitest";
+import {
+  LOCALE_STORAGE_KEY,
+  loadLocalePreference,
+  resolveLocalePreference,
+  saveLocalePreference,
+  type LocaleStorage,
+} from "./locale-preference";
+
+const supportedLocales = ["en", "zh-CN", "de"] as const;
+
+function createStorage(initial: Record<string, string> = {}): LocaleStorage & { values: Map<string, string> } {
+  const values = new Map(Object.entries(initial));
+  return {
+    values,
+    getItem: (key) => values.get(key) ?? null,
+    setItem: (key, value) => values.set(key, value),
+  };
+}
+
+describe("locale preference", () => {
+  it("keeps a saved supported locale ahead of the browser language", () => {
+    expect(resolveLocalePreference({
+      storedLocale: "en",
+      browserLocale: "zh-CN",
+      supportedLocales,
+      fallbackLocale: "en",
+    })).toBe("en");
+  });
+
+  it("maps browser locale variants to the closest supported locale", () => {
+    expect(resolveLocalePreference({
+      storedLocale: null,
+      browserLocale: "zh-TW",
+      supportedLocales,
+      fallbackLocale: "en",
+    })).toBe("zh-CN");
+    expect(resolveLocalePreference({
+      storedLocale: null,
+      browserLocale: "de-AT",
+      supportedLocales,
+      fallbackLocale: "en",
+    })).toBe("de");
+  });
+
+  it("uses the fallback locale for unsupported preferences and browser languages", () => {
+    expect(resolveLocalePreference({
+      storedLocale: "xx",
+      browserLocale: "fr-FR",
+      supportedLocales,
+      fallbackLocale: "en",
+    })).toBe("en");
+  });
+
+  it("loads a saved locale and tolerates unavailable storage", () => {
+    const storage = createStorage({ [LOCALE_STORAGE_KEY]: "zh-CN" });
+    expect(loadLocalePreference(storage, "en-US", supportedLocales, "en")).toBe("zh-CN");
+
+    const brokenStorage: LocaleStorage = {
+      getItem: () => { throw new Error("storage unavailable"); },
+      setItem: () => { throw new Error("storage unavailable"); },
+    };
+    expect(loadLocalePreference(brokenStorage, "zh-HK", supportedLocales, "en")).toBe("zh-CN");
+    expect(loadLocalePreference(null, null, supportedLocales, "en")).toBe("en");
+  });
+
+  it("persists supported locales and ignores invalid or unavailable writes", () => {
+    const storage = createStorage();
+    expect(saveLocalePreference("zh-CN", supportedLocales, storage)).toBe(true);
+    expect(storage.values.get(LOCALE_STORAGE_KEY)).toBe("zh-CN");
+    expect(saveLocalePreference("xx", supportedLocales, storage)).toBe(false);
+    expect(saveLocalePreference("en", supportedLocales, null)).toBe(false);
+
+    const brokenStorage: LocaleStorage = {
+      getItem: () => null,
+      setItem: () => { throw new Error("storage unavailable"); },
+    };
+    expect(saveLocalePreference("en", supportedLocales, brokenStorage)).toBe(false);
+  });
+});
diff --git a/ui/src/i18n/locale-preference.ts b/ui/src/i18n/locale-preference.ts
new file mode 100644
index 0000000..d6ef189
--- /dev/null
+++ b/ui/src/i18n/locale-preference.ts
@@ -0,0 +1,71 @@
+export const LOCALE_STORAGE_KEY = "paperclip.locale";
+
+export interface LocaleStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+interface LocalePreferenceOptions {
+  storedLocale: string | null;
+  browserLocale: string | null;
+  supportedLocales: readonly string[];
+  fallbackLocale: string;
+}
+
+export function resolveLocalePreference({
+  storedLocale,
+  browserLocale,
+  supportedLocales,
+  fallbackLocale,
+}: LocalePreferenceOptions) {
+  const stored = supportedLocales.find((locale) => locale.toLowerCase() === storedLocale?.toLowerCase());
+  if (stored) return stored;
+
+  const normalizedBrowserLocale = browserLocale?.replaceAll("_", "-").toLowerCase();
+  if (!normalizedBrowserLocale) return fallbackLocale;
+
+  const exact = supportedLocales.find((locale) => locale.toLowerCase() === normalizedBrowserLocale);
+  if (exact) return exact;
+
+  const language = normalizedBrowserLocale.split("-")[0];
+  return supportedLocales.find((locale) => locale.toLowerCase().split("-")[0] === language) ?? fallbackLocale;
+}
+
+export function loadLocalePreference(
+  storage: LocaleStorage | null,
+  browserLocale: string | null,
+  supportedLocales: readonly string[],
+  fallbackLocale: string,
+) {
+  let storedLocale: string | null = null;
+  try {
+    storedLocale = storage?.getItem(LOCALE_STORAGE_KEY) ?? null;
+  } catch {
+    // Storage can be disabled by the browser or privacy settings.
+  }
+
+  return resolveLocalePreference({ storedLocale, browserLocale, supportedLocales, fallbackLocale });
+}
+
+export function saveLocalePreference(
+  locale: string,
+  supportedLocales: readonly string[],
+  storage: LocaleStorage | null,
+) {
+  if (!storage || !supportedLocales.includes(locale)) return false;
+
+  try {
+    storage.setItem(LOCALE_STORAGE_KEY, locale);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export function browserLocaleStorage(): LocaleStorage | null {
+  try {
+    return typeof window === "undefined" ? null : window.localStorage;
+  } catch {
+    return null;
+  }
+}
